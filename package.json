{
  "name": "tv-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PWA mobile-first per tracciare le serie TV seguite, offline-first con TMDB",
  "scripts": {
    "dev": "vite",
    "check-node": "node scripts/check-node-version.mjs",
    "build": "npm run check-node && npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
