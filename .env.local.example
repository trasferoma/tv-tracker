# Copia questo file in `.env.local` e riempi i valori.
# `.env.local` NON è versionato: lo esclude il .gitignore.

# --- Segreto vero: non deve mai raggiungere il browser ---
# Read Access Token v4 di TMDB, usato con l'header `Authorization: Bearer`.
# Lo legge il proxy di sviluppo dentro vite.config.ts, che gira in Node.
# In produzione NON si usa questo file: il valore è un secret di Cloudflare
# letto dalla Pages Function.
# Si ottiene da https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=

# --- Non è un segreto: finisce nel bundle del browser ---
# Password della modalità locale, prima che arrivi Firebase Authentication.
# Il prefisso VITE_ è obbligatorio perché il valore serve nel browser, ed è
# anche la ragione per cui è leggibile da chiunque apra gli strumenti per
# sviluppatori: è un controllo di cortesia, non una prova di identità.
# Sparisce alla Fase 21, sostituito da Firebase Authentication.
VITE_LOCAL_PASSWORD=

# --- Firebase (dalla Fase 20) ---
# La configurazione web di Firebase NON è un segreto: è pensata per stare nel
# bundle del browser. A proteggere i dati sono le regole di Firestore, che
# consentono l'accesso ai soli membri del nucleo.
# Si ottiene dalla console Firebase: Impostazioni progetto → Generali → Le tue app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Identificativo del nucleo condiviso: raggruppa i dati delle due persone.
VITE_FIREBASE_HOUSEHOLD_ID=

# Indirizzi con cui i due profili accedono: Firebase autentica per email.
VITE_FIREBASE_FABIO_EMAIL=
VITE_FIREBASE_IRENE_EMAIL=

# uid dei due account, usati SOLO per creare una tantum i documenti
# members/{uid} (Fase 23). L'app non li legge.
FIREBASE_FABIO_UID=
FIREBASE_IRENE_UID=

# Modalità locale: attivazione SOLO ESPLICITA. Accesa solo se vale esattamente
# "true", mai dedotta dall assenza della configurazione Firebase. Senza questa
# variabile e senza configurazione Firebase completa il build fallisce.
VITE_LOCAL_MODE=
